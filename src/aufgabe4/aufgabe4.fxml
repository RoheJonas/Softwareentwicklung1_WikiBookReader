<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="aufgabe4.Aufgabe4Controller"
      spacing="10"
      style="-fx-padding: 10;">

    <HBox spacing="10">
        <TextField fx:id="_searchField"
                   promptText="Buchtitel eingeben (z.B. Java Standard)"
                   HBox.hgrow="ALWAYS"
                   onKeyPressed="#onSearchFieldKeyPressed"/>
        <Button text="Suchen"
                onAction="#onSearchButtonClicked"/>
    </HBox>

    <WebView fx:id="_webView" VBox.vgrow="ALWAYS"/>

</VBox>
